rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection (Public profile data & private sensitive PII subcollection)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Private sensitive PII subcollection (Strict owner-only read/write)
      match /private/{privateDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Blood requests collection
    match /blood_requests/{requestId} {
      allow read: if request.auth != null;

      // A request is born open and unassigned, created by the patient it is for.
      // Ownership is fixed at creation: the completion, assignment and
      // cancellation fields cannot be forged or pre-filled by the creator.
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['userId', 'patientName', 'phoneNumber', 'bloodGroup', 'bloodBags', 'hospitalName', 'hospitalAddress', 'requiredDateTime', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['userId', 'patientName', 'phoneNumber', 'bloodGroup', 'bloodBags', 'hospitalName', 'hospitalAddress', 'requiredDateTime', 'requestType', 'notes', 'latitude', 'longitude', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() > 0
        && request.resource.data.phoneNumber is string
        && request.resource.data.hospitalName is string
        && request.resource.data.hospitalName.size() > 0
        && request.resource.data.bloodGroup is string
        && request.resource.data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
        && request.resource.data.bloodBags is int
        && request.resource.data.bloodBags >= 1;

      // Exactly four ways to update a request, and nothing else:
      //   1. the patient edits the details of their own request while it is open;
      //   2. the patient cancels their own request while it is open or accepted;
      //   3. a matching, available donor claims an open request or closes out an
      //      accepted one (never their own, and never anyone else's);
      //   4. the patient confirms a completed donation, which is the only path to
      //      'fulfilled' and the precondition for a rating or a post.
      //
      // Every branch is keyed on the stored document, so the owner identity
      // cannot be rewritten, a request cannot be handed to another user, an
      // assigned donor cannot be swapped, and no status can move backwards.
      allow update: if request.auth != null && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          (
            (resource.data.status == 'open' &&
             request.resource.data.status == 'open' &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'patientName', 'phoneNumber', 'bloodGroup', 'bloodBags',
               'hospitalName', 'hospitalAddress', 'requiredDateTime',
               'requestType', 'notes', 'latitude', 'longitude'
             ])) ||
            (resource.data.status in ['open', 'accepted'] &&
             request.resource.data.status == 'cancelled' &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']) &&
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['cancelledAt']) ||
              request.resource.data.cancelledAt == request.time)) ||
            (resource.data.status == 'donation_completed' &&
             request.resource.data.status == 'fulfilled' &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'fulfilledAt']) &&
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fulfilledAt']) ||
              request.resource.data.fulfilledAt == request.time))
          )
        ) ||
        (
          request.auth.uid != resource.data.userId &&
          (
            (resource.data.status == 'open' &&
             request.resource.data.status == 'accepted' &&
             request.resource.data.assignedDonorId == request.auth.uid &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assignedDonorId', 'acceptedAt'])) ||
            (resource.data.status == 'accepted' &&
             resource.data.assignedDonorId == request.auth.uid &&
             request.resource.data.status == 'donation_completed' &&
             request.resource.data.assignedDonorId == resource.data.assignedDonorId &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']))
          ) &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'donor' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAvailable == true &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bloodGroup == resource.data.bloodGroup
        )
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Request responses collection (Secured: read by donor or request owner; create/update with immutable IDs & valid status)
    match /request_responses/{responseId} {
      allow read: if request.auth != null && (
        resource.data.donorId == request.auth.uid ||
        (exists(/databases/$(database)/documents/blood_requests/$(resource.data.requestId)) &&
         get(/databases/$(database)/documents/blood_requests/$(resource.data.requestId)).data.userId == request.auth.uid)
      );
      allow create: if request.auth != null
                    && request.resource.data.donorId == request.auth.uid
                    && request.resource.data.requestId is string
                    && request.resource.data.status in ['accepted', 'declined']
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'donor'
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAvailable == true
                    && exists(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId))
                    && get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.bloodGroup == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bloodGroup
                    && (
                      (request.resource.data.status == 'declined' &&
                       get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.status == 'open') ||
                      (request.resource.data.status == 'accepted' &&
                       getAfter(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.status == 'accepted' &&
                       getAfter(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.assignedDonorId == request.auth.uid)
                    );
      allow update: if request.auth != null
                    && resource.data.donorId == request.auth.uid
                    && request.resource.data.donorId == resource.data.donorId
                    && request.resource.data.requestId == resource.data.requestId
                    && request.resource.data.status in ['accepted', 'declined', 'pending']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'donorName', 'donorPhone', 'createdAt']);
      allow delete: if request.auth != null && resource.data.donorId == request.auth.uid;
    }

    // Response claims collection (Secured: one immutable claim per request/donor pair)
    match /response_claims/{claimId} {
      // A claim document is the transactional anchor that makes "first donor to
      // accept wins" atomic. The booking transaction must read the claim *before*
      // it exists, so reading a non-existent claim id is allowed; an existing claim
      // remains readable only by the donor who owns it.
      allow read: if request.auth != null && (
        !exists(/databases/$(database)/documents/response_claims/$(claimId)) ||
        resource.data.donorId == request.auth.uid
      );

      // Claims are only ever created, in the same transaction that writes the
      // matching request_responses document. The claim must point at a response the
      // caller actually owns for the same request. update/delete stay closed so a
      // winning claim can never be released or reassigned.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['requestId', 'donorId', 'responseId'])
                    && request.resource.data.keys().hasOnly(['requestId', 'donorId', 'responseId'])
                    && request.resource.data.requestId is string
                    && request.resource.data.donorId is string
                    && request.resource.data.donorId == request.auth.uid
                    && request.resource.data.responseId is string
                    && request.resource.data.responseId.size() > 0
                    && existsAfter(/databases/$(database)/documents/request_responses/$(request.resource.data.responseId))
                    && getAfter(/databases/$(database)/documents/request_responses/$(request.resource.data.responseId)).data.donorId == request.auth.uid
                    && getAfter(/databases/$(database)/documents/request_responses/$(request.resource.data.responseId)).data.requestId == request.resource.data.requestId;

      allow update, delete: if false;
    }

    // Notifications collection (Secured: recipientUid present and never the sender,
    // verified request or response existence for every notification type)
    match /notifications/{notificationId} {
      // Predicate describing whether the caller may raise a notification for the
      // recipient encoded in the payload. Used by both create and update so that
      // idempotent re-writes cannot drift away from the original relationship.
      //
      // Nobody may notify themselves: the old self-addressed branch let a caller
      // create a notification whose recipient was the sender, and the recipient
      // update branch then became a write to any document.
      //
      // new_request is raised by the request owner, to a donor, while the request
      // is open. donor_response resolves the response document through responseId
      // (NOT requestId, which points at blood_requests) and pins the notification
      // to the donor who owns that response and the recipient who owns the request.
      // request_cancelled is raised by the request owner to the donor who had
      // accepted, and is valid both inside the cancelling batch (request still
      // 'accepted') and after it (request already 'cancelled').
      function isAuthorizedNotificationPayload() {
        return request.resource.data.recipientUid is string
          && request.resource.data.recipientUid.size() > 0
          && request.resource.data.recipientUid != request.auth.uid
          && request.resource.data.requestId is string
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.type == 'new_request' &&
             exists(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)) &&
             get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.userId == request.auth.uid &&
             get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.status == 'open') ||
            (request.resource.data.type == 'donor_response' &&
             request.resource.data.responseId is string &&
             request.resource.data.responseId.size() > 0 &&
             exists(/databases/$(database)/documents/request_responses/$(request.resource.data.responseId)) &&
             get(/databases/$(database)/documents/request_responses/$(request.resource.data.responseId)).data.donorId == request.auth.uid &&
             get(/databases/$(database)/documents/request_responses/$(request.resource.data.responseId)).data.requestId == request.resource.data.requestId &&
             exists(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)) &&
             get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.userId == request.resource.data.recipientUid) ||
            (request.resource.data.type == 'donation_completed' &&
             exists(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)) &&
             get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.userId == request.resource.data.recipientUid &&
             get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.assignedDonorId == request.auth.uid &&
             get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.status == 'donation_completed') ||
            (request.resource.data.type == 'donation_confirmed' &&
             exists(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)) &&
             get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.assignedDonorId == request.resource.data.recipientUid &&
             get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.userId == request.auth.uid &&
             get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.status == 'fulfilled') ||
            (request.resource.data.type == 'request_cancelled' &&
             exists(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)) &&
             get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.userId == request.auth.uid &&
             get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.assignedDonorId == request.resource.data.recipientUid &&
             get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.status in ['accepted', 'cancelled'])
          );
      }

      // Only the recipient can list, open, or delete their own notifications.
      allow read, delete: if request.auth != null && resource.data.recipientUid == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['recipientUid', 'requestId', 'responseId', 'type', 'title', 'body', 'createdAt'])
                    && isAuthorizedNotificationPayload();

      // The recipient may only mark a notification as read; they cannot edit its
      // text, retype it or hand it to another user. The original sender may also
      // re-raise the exact same notification (deterministic document IDs make the
      // client write idempotent), but it may only refresh the display text: the
      // recipient, request, type and read state can never be altered.
      allow update: if request.auth != null && (
        (resource.data.recipientUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])) ||
        (
          isAuthorizedNotificationPayload()
          && request.resource.data.recipientUid == resource.data.recipientUid
          && request.resource.data.requestId == resource.data.requestId
          && request.resource.data.type == resource.data.type
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'createdAt', 'responseId'])
        )
      );
    }

    // Feed: posts, with comments and likes as subcollections (Stage 8.1.1
    // reconciliation, ARCHITECTURE section 14.1). The create shape mirrors
    // PostDocument.requiredFields exactly; the Dart validators (2000-char
    // text, four images, paths <= urls, counters from zero) are the ceiling,
    // so client-side validation is never the only boundary. The stale
    // singular `imageUrl` key and the `donationRecordId` branch are gone:
    // nothing in the app reads or writes either, and the canonical schema
    // names `imageUrls`/`imagePaths`.
    match /posts/{postId} {
      // Parameterless and keyed on request.resource.data, like
      // isAuthorizedNotificationPayload above: the rules compiler cannot
      // resolve list comprehensions over a function parameter. Both create
      // and update validate the same body, so reading the one global the
      // engine does bind is the idiom this file already proves.
      function isPostBody() {
        return request.resource.data.authorUid is string
          && request.resource.data.authorUid.size() > 0
          && request.resource.data.authorName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.imageUrls is list
          && request.resource.data.imageUrls.size() <= 4
          && request.resource.data.imagePaths is list
          && request.resource.data.imagePaths.size() <= 4
          && request.resource.data.imagePaths.size() <= request.resource.data.imageUrls.size()
          // Element types are NOT checked here: this emulator's rules engine
          // fails `Function not found [all]` on list comprehensions over
          // data-derived lists (pinned by the Stage 8.1 tests). The blast
          // radius is a garbage document, not a forged one: PostDocument
          // .fromMap refuses any non-string element at read time, so a
          // poisoned list renders as a rejected post, never as someone
          // else's picture. Closed properly once the emulator's CEL
          // comprehensions work (firebase-tools upgrade).
          && (!request.resource.data.keys().hasAny(['authorPhotoUrl']) || request.resource.data.authorPhotoUrl is string);
      }

      allow read: if request.auth != null;

      // Publish: the nine required keys, nothing else but an optional
      // authorPhotoUrl, author is the caller, counters start at zero, and
      // both timestamps are the server's now (a device clock cannot order
      // the feed for everybody else).
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasAll(['authorUid', 'authorName', 'text', 'imageUrls', 'imagePaths', 'likeCount', 'commentCount', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'text', 'imageUrls', 'imagePaths', 'likeCount', 'commentCount', 'createdAt', 'updatedAt', 'authorPhotoUrl'])
        && isPostBody()
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Edit: author only, and only the body plus the edit marker and the
      // refreshed stamp. The author snapshot, the counters and createdAt are
      // immutable. The old any-signed-in-user +1/-1 likeCount branch was a
      // counter-forging hole with no paired like write behind it; counters
      // move only when a transaction that writes posts/{id}/likes/{uid}
      // alongside them exists, and nothing in the app writes either yet.
      // An edit must restamp updatedAt with the server's clock.
      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'imageUrls', 'imagePaths', 'editedAt', 'updatedAt'])
        && isPostBody()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['editedAt'])
            || request.resource.data.editedAt == request.time);

      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;

      // Comment: shape enforced (it was unchecked before), the validator's
      // 500 bound, a server timestamp, and the parent post must exist.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.keys().hasAll(['authorUid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'authorPhotoUrl', 'text', 'parentId', 'replyToName', 'createdAt'])
          && request.resource.data.authorUid is string
          && request.resource.data.authorUid.size() > 0
          && request.resource.data.authorName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && (!request.resource.data.keys().hasAny(['authorPhotoUrl']) || request.resource.data.authorPhotoUrl is string || request.resource.data.authorPhotoUrl == null)
          && (!request.resource.data.keys().hasAny(['parentId']) || request.resource.data.parentId is string || request.resource.data.parentId == null)
          && (!request.resource.data.keys().hasAny(['replyToName']) || request.resource.data.replyToName is string || request.resource.data.replyToName == null)
          && exists(/databases/$(database)/documents/posts/$(postId));
        // Comments are append-only; an edited comment must be deleted and
        // rewritten so the thread cannot silently change under a reply.
        allow update: if false;
        allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
      }

      // Like: one document per liker, the id IS the liker's uid, so a
      // duplicate like is a duplicate id (an update, refused below) rather
      // than an undetectable second row, and unlike is a delete of one's own
      // document. Replaces the unbound top-level post_likes collection.
      match /likes/{likeId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && likeId == request.auth.uid
          && request.resource.data.keys().hasOnly(['likedAt'])
          && request.resource.data.likedAt == request.time;
        allow update: if false;
        allow delete: if request.auth != null && likeId == request.auth.uid;
      }
    }

    // The old flat likes collection is retired with the subcollection move:
    // no client of the canonical schema writes here any more, and nothing
    // may read the stranded documents from a client either.
    match /post_likes/{likeId} {
      allow read, write: if false;
    }

    // Reports: create-only, mirroring the Report entity (two targets, five
    // reasons, 300-character note). There is no client read path and there
    // will not be one from a user context — moderation reads from the
    // console — so every read is denied and update/delete are closed. The
    // collection had no rules at all before this stage.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasAll(['reporterUid', 'target', 'targetId', 'targetAuthorUid', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['reporterUid', 'target', 'targetId', 'targetAuthorUid', 'reason', 'note', 'createdAt'])
        && request.resource.data.target in ['post', 'comment']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetAuthorUid is string
        && request.resource.data.targetAuthorUid.size() > 0
        && request.resource.data.reason in ['spam', 'harassment', 'hate_speech', 'misinformation', 'other']
        && (!request.resource.data.keys().hasAny(['note'])
            || (request.resource.data.note is string && request.resource.data.note.size() <= 300))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }


    // One recipient rating per completed donation (document ID is the blood request ID).
    match /donation_ratings/{requestId} {
      // Ratings are public community feedback for donor profiles and feed cards.
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['requestId', 'donorUid', 'recipientUid', 'stars', 'review', 'createdAt'])
        && request.resource.data.keys().hasOnly(['requestId', 'donorUid', 'recipientUid', 'stars', 'review', 'createdAt'])
        && request.resource.data.requestId == requestId
        && request.resource.data.recipientUid == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() <= 300
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/blood_requests/$(requestId))
        && get(/databases/$(database)/documents/blood_requests/$(requestId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/blood_requests/$(requestId)).data.status == 'fulfilled'
        && get(/databases/$(database)/documents/blood_requests/$(requestId)).data.assignedDonorId == request.resource.data.donorUid;
      allow update, delete: if false;
    }

    // --- Donation History Collection ---
    match /donation_history/{recordId} {
      // Read: Only the owning donor can read their private donation history
      allow read: if request.auth != null && resource.data.donorUid == request.auth.uid;

      // Create: Strict keys presence, allowed keys, type validations, pending status, nullable donationDate and requestId
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['donorUid', 'bloodGroup', 'hospitalName', 'status', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['donorUid', 'bloodGroup', 'hospitalName', 'status', 'createdAt', 'donationDate', 'requestId', 'confirmedBy'])
                    && request.resource.data.donorUid is string
                    && request.resource.data.status is string
                    && (
                      (request.resource.data.donorUid == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       !request.resource.data.keys().hasAny(['confirmedBy']) &&
                       request.resource.data.keys().hasAll(['donorUid', 'bloodGroup', 'hospitalName', 'status', 'createdAt'])) ||
                      // A confirmed record is written by the request owner, about
                      // someone else, and only from a request that is genuinely
                      // theirs, actually assigned to that donor, past completion
                      // ('donation_completed' in the same batch as the confirmation,
                      // or 'fulfilled' if the owner confirmed first), for the same
                      // blood group the request asked for.
                      (request.resource.data.status == 'confirmed' &&
                       request.resource.data.donorUid != request.auth.uid &&
                       request.resource.data.confirmedBy == request.auth.uid &&
                       request.resource.data.requestId is string &&
                       exists(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)) &&
                       get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.userId == request.auth.uid &&
                       get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.status in ['donation_completed', 'fulfilled'] &&
                       get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.assignedDonorId == request.resource.data.donorUid &&
                       get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.bloodGroup == request.resource.data.bloodGroup &&
                       get(/databases/$(database)/documents/blood_requests/$(request.resource.data.requestId)).data.hospitalName == request.resource.data.hospitalName &&
                       request.resource.data.donationDate is timestamp &&
                       request.resource.data.keys().hasAll(['donorUid', 'bloodGroup', 'hospitalName', 'status', 'createdAt', 'donationDate', 'requestId', 'confirmedBy']))
                    )
                    && request.resource.data.hospitalName is string
                    && request.resource.data.hospitalName.size() > 0
                    && request.resource.data.bloodGroup is string
                    && request.resource.data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.createdAt == request.time
                    && (!request.resource.data.keys().hasAll(['donationDate']) || request.resource.data.donationDate is timestamp || request.resource.data.donationDate == null)
                    && (!request.resource.data.keys().hasAll(['requestId']) || request.resource.data.requestId is string || request.resource.data.requestId == null);

      // Update: Disabled entirely for clients to prevent any tampering with pending records
      allow update: if false;

      // Delete: Owner can delete only pending records
      allow delete: if request.auth != null
                    && resource.data.donorUid == request.auth.uid
                    && resource.data.status == 'pending';
    }
  }
}
