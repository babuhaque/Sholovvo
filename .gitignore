# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Node tooling (Firestore security rules tests)
node_modules/

# Firebase emulator logs
firebase-debug.log
firestore-debug.log
ui-debug.log

# Machine-local tool state. The Supabase link and CLI cache differ per machine,
# and the IDE keeps project-scoped scratch data here.
supabase/.temp/
.qoder/

# Local secrets. Never commit these:
# - Firebase Admin service account keys bypass every security rule.
# - Supabase service role keys bypass storage RLS.
# - Release signing material must stay off the repository.
.env
.env.*
**/service-account*.json
**/*adminsdk*.json
*.jks
*.keystore
android/key.properties
